{
  "output": "google-search-promo.mp4",
  "theme": {
    "accent": "#1a73e8",
    "accent2": "#34a8ff",
    "bg": "#f6f8fc",
    "ink": "#0b1426",
    "muted": "#6b7280",
    "brand": "Google Search",
    "url": "google.com"
  },
  "scenes": [
    { "type": "kinetic", "vo": "t0", "phrases": ["A quick look at", "Google search", "Voice by Kokoro"] },
    {
      "type": "screen",
      "stage": "desktop",
      "title": "Ask anything",
      "focus": [
        { "mark": "search-box", "scale": 1.7, "lead": 1.0 },
        { "mark": "suggestions", "scale": 1.5, "lead": 0.6 },
        { "mark": "picked", "scale": 2.6, "lead": 2.6 }
      ],
      "clicks": ["search-box"]
    },
    { "type": "kinetic", "vo": "t2", "phrases": ["Same search.", "On a phone."] },
    {
      "type": "screen",
      "stage": "mobile",
      "focus": [{ "mark": "suggestions", "scale": 1.15, "lead": 0.8 }],
      "clicks": ["search-box"]
    },
    { "type": "kinetic", "vo": "t9", "phrases": ["Start typing.", "Google finishes the thought."] },
    { "type": "outro", "seconds": 3.2 }
  ]
}
